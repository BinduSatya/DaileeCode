# One key per Gemini agent — each has its own independent free tier quota
GEMINI_API_KEY_SOLUTION=your_key_for_solution_agent
GEMINI_API_KEY_SCRIPT=your_key_for_script_agent



# ── YouTube Data API v3 ──────────────────────────────
# Path to the OAuth 2.0 client_secrets.json downloaded from Google Cloud Console
YOUTUBE_CLIENT_SECRETS=******************
# After first run, the token is cached here automatically
YOUTUBE_TOKEN_FILE=youtube_token.json

# ── Optional tweaks ──────────────────────────────────
# Language for TTS voice (see edge-tts --list-voices)
TTS_VOICE=en-US-AriaNeural
# YouTube privacy: public | unlisted | private
YOUTUBE_PRIVACY=public
